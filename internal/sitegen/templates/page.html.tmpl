<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="{{.AssetPrefix}}style.css">
</head>
<body>
<header class="page-header">
<div class="header-top">
<h1>{{.Title}}</h1>
<nav class="lang-switch"><span class="lang-current">{{.SelfLangLabel}}</span> · <a href="{{.SwitchLangHref}}">{{.SwitchLangLabel}}</a></nav>
</div>
</header>

<main>
<section class="calendars" aria-labelledby="calendars-heading">
<h2 id="calendars-heading" class="sr-only">{{.SectionHeading}}</h2>
<ul class="calendar-grid">
{{range .Locations}}
<li class="calendar-card">
<a class="card-link" href="{{.ICSHref}}" aria-label="{{.SubscribeAriaLabel}}">
<p class="loc-row"><span class="loc-name"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> {{.Name}}</span><span class="loc-postal">{{.PostalCode}}</span></p>
</a>
<div class="card-actions">
<button class="copy-btn" type="button" data-copied-label="{{$.CopiedLabel}}" aria-label="{{.CopyAriaLabel}}" hidden><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> <span class="copy-label">{{$.CopyLabel}}</span></button>
<details class="direct-link">
<summary>{{$.DirectLinkLabel}}</summary>
{{if .ICSAbsoluteURL}}
<code class="ics-url">{{.ICSAbsoluteURL}}</code>
{{else}}
<code class="ics-url" data-needs-abs-url data-href="{{.ICSHref}}">{{.ICSHref}}</code>
{{end}}
</details>
</div>
</li>
{{end}}
</ul>
<ul class="reassurance">
{{range .Reassurance}}<li>✓ {{.}}</li>
{{end}}
</ul>
</section>

<section class="how-to">
<details>
<summary>{{.HowToSubscribe.Heading}}</summary>
<ul>
<li><strong>Google Calendar</strong> — {{.HowToSubscribe.Google}}</li>
<li><strong>Outlook</strong> — {{.HowToSubscribe.Outlook}}</li>
<li><strong>Apple Calendar / iOS</strong> — {{.HowToSubscribe.Apple}}</li>
<li><strong>Android</strong> — {{.HowToSubscribe.Android}}</li>
</ul>
</details>
<details>
<summary>{{.HowToUnsubscribe.Heading}}</summary>
<ul>
<li><strong>Google Calendar</strong> — {{.HowToUnsubscribe.Google}}</li>
<li><strong>Outlook</strong> — {{.HowToUnsubscribe.Outlook}}</li>
<li><strong>Apple Calendar / iOS</strong> — {{.HowToUnsubscribe.Apple}}</li>
<li><strong>Android</strong> — {{.HowToUnsubscribe.Android}}</li>
</ul>
</details>
</section>
</main>

<script src="{{.AssetPrefix}}script.js"></script>
</body>
</html>
